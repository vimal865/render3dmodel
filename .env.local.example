# Copy this file to .env.local and fill in real values.
# .env.local is gitignored -- never commit real keys.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio -> Get API key
# Requires a Google Cloud billing account attached, even for light usage --
# that's how Google meters image generation, there's no free path around it.
GEMINI_API_KEY=

# Spend controls (optional -- these defaults apply if unset).
# Each render is a paid API call, so these cap what a single account
# can cost you per day.
DAILY_RENDER_LIMIT=20
DAILY_ANALYSIS_LIMIT=100

# Set to false to stop recording IP addresses in the activity log.
# IPs are personal data under India's DPDP Act and the GDPR; the log
# remains useful without them.
LOG_IP_ADDRESSES=true

# Optional. Sentry project DSN (Settings -> Client Keys in Sentry) for
# production error tracking. Leave unset to run without it -- src/
# instrumentation.ts and instrumentation-client.ts both no-op when this
# is empty, so nothing breaks either way.
NEXT_PUBLIC_SENTRY_DSN=
